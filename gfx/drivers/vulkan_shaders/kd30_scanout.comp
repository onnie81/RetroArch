bool sample_glyph_8x8(int ch, int gx, int gy) {
    if (gx < 0 || gx >= 8 || gy < 0 || gy >= 8) return false;
    uvec2 g = get_glyph_8x8(ch);
    uint word = (gy < 4) ? g.x : g.y;
    uint row_shift = uint(3 - (gy & 3)) * 8u;
    uint row_byte = (word >> row_shift) & 0xFFu;
    return ((row_byte >> uint(7 - gx)) & 1u) != 0u;
}

int sample_outlined_glyph(int ch, int gx, int gy) {
    if (ch == 32) return 0;
    if (sample_glyph_8x8(ch, gx, gy)) return 2;
    if (sample_glyph_8x8(ch, gx - 1, gy) || sample_glyph_8x8(ch, gx + 1, gy) ||
        sample_glyph_8x8(ch, gx, gy - 1) || sample_glyph_8x8(ch, gx, gy + 1) ||
        sample_glyph_8x8(ch, gx - 1, gy - 1) || sample_glyph_8x8(ch, gx + 1, gy + 1)) {
        return 1;
    }
    return 0;
}

int format_float_char(float val, int rel_col) {
    int v = int(round(clamp(val, 0.0, 9.99) * 100.0));
    if (rel_col == 0) return 48 + ((v / 100) % 10);
    if (rel_col == 1) return 46;
    if (rel_col == 2) return 48 + ((v / 10) % 10);
    if (rel_col == 3) return 48 + (v % 10);
    return 32;
}

int format_fps_char(float val, int rel_col) {
    int v = int(round(clamp(val, 0.0, 999.9) * 10.0));
    int d3 = (v / 1000) % 10;
    int d2 = (v / 100) % 10;
    int d1 = (v / 10) % 10;
    int d0 = v % 10;
    if (rel_col == 0) return (d3 > 0) ? (48 + d3) : 32;
    if (rel_col == 1) return (d3 > 0 || d2 > 0) ? (48 + d2) : 32;
    if (rel_col == 2) return 48 + d1;
    if (rel_col == 3) return 46;
    if (rel_col == 4) return 48 + d0;
    return 32;
}

int format_ms_char(float val, int rel_col) {
    int v = int(round(clamp(val, 0.0, 99.99) * 100.0));
    int d3 = (v / 1000) % 10;
    int d2 = (v / 100) % 10;
    int d1 = (v / 10) % 10;
    int d0 = v % 10;
    if (rel_col == 0) return (d3 > 0) ? (48 + d3) : 32;
    if (rel_col == 1) return 48 + d2;
    if (rel_col == 2) return 46;
    if (rel_col == 3) return 48 + d1;
    if (rel_col == 4) return 48 + d0;
    return 32;
}

int format_uint4_char(uint val, int rel_col) {
    int v = int(clamp(val, 0u, 9999u));
    int d3 = (v / 1000) % 10;
    int d2 = (v / 100) % 10;
    int d1 = (v / 10) % 10;
    int d0 = v % 10;
    if (rel_col == 0) return (v >= 1000) ? (48 + d3) : 32;
    if (rel_col == 1) return (v >= 100)  ? (48 + d2) : 32;
    if (rel_col == 2) return (v >= 10)   ? (48 + d1) : 32;
    if (rel_col == 3) return 48 + d0;
    return 32;
}

int format_scanlines_char(uint lines, uint scan_fmt, int rel_col) {
    uint disp_lines = (scan_fmt == 2u) ? 1080u : ((scan_fmt == 1u && lines < 400u) ? (lines * 2u) : lines);
    bool interlaced = (scan_fmt != 0u);
    int v = int(clamp(disp_lines, 0u, 9999u));
    if (v >= 1000) {
        if (rel_col == 0) return 48 + (v / 1000) % 10;
        if (rel_col == 1) return 48 + (v / 100) % 10;
        if (rel_col == 2) return 48 + (v / 10) % 10;
        if (rel_col == 3) return 48 + (v % 10);
        if (rel_col == 4) return interlaced ? 73 : 80;
    } else {
        if (rel_col == 0) return 48 + (v / 100) % 10;
        if (rel_col == 1) return 48 + (v / 10) % 10;
        if (rel_col == 2) return 48 + (v % 10);
        if (rel_col == 3) return interlaced ? 73 : 80;
    }
    return 32;
}

int banner_char_at(int row, int col) {
    if (row == 0) {
        const int v_prefix[6] = {86, 73, 68, 69, 79, 32}; // "VIDEO "
        if (col >= 0 && col < 6) return v_prefix[col];
        if (col == 6) return (pc.input_mode == 0u) ? 49 : ((pc.input_mode == 1u) ? 50 : 52);
        if (col == 7) return 32;
        if (pc.input_mode == 0u) {
            const int s[4] = {67, 86, 66, 83}; // "CVBS"
            if (col >= 8 && col < 12) return s[col - 8];
        } else if (pc.input_mode == 1u) {
            const int s[3] = {89, 47, 67}; // "Y/C"
            if (col >= 8 && col < 11) return s[col - 8];
        } else {
            const int s[4] = {67, 79, 77, 80}; // "COMP"
            if (col >= 8 && col < 12) return s[col - 8];
        }
    } else if (row == 1) {
        if (pc.signal_standard == 0u) {
            const int s[5] = {78, 84, 83, 67, 32}; // "NTSC "
            if (col >= 0 && col < 5) return s[col];
        } else {
            const int s[5] = {80, 65, 76, 32, 32}; // "PAL  "
            if (col >= 0 && col < 5) return s[col];
        }
        if (col >= 5 && col <= 9) {
            return format_scanlines_char(pc.scan_size.y, pc.scan_format, col - 5);
        }
    }
    return 32;
}

int menu_char_at(int row, int col) {
    if (col < 1 || col > 26) return 32;
    int c = col - 1; // 0..25

    if (row == 0) {
        const int hdr[24] = {83,79,78,89,32,75,68,45,51,48,88,83,57,53,53,32,68,65,45,52,32,79,83,68};
        return (c >= 1 && c <= 24) ? hdr[c - 1] : 32;
    }
    if (row == 11) {
        // "G:MASK  A:ASPECT  B:BEAM  "
        const int ftr[26] = {71,58,77,65,83,75,32,32,65,58,65,83,80,69,67,84,32,32,66,58,66,69,65,77,32,32};
        return (c >= 0 && c < 26) ? ftr[c] : 32;
    }

    int item = row - 1;
    if (item < 0 || item > 9) return 32;

    if (c == 0) return (uint(item) == pc.osd_selected_row) ? 62 : 32;
    if (c == 1) return 32;

    if (c >= 2 && c <= 13) {
        int lc = c - 2;
        if (item == 0) { const int L[12] = {73,78,80,85,84,32,74,65,67,75,32,32}; return L[lc]; } // "INPUT JACK  "
        if (item == 1) { const int L[12] = {67,79,76,79,82,32,83,89,83,84,69,77}; return L[lc]; } // "COLOR SYSTEM"
        if (item == 2) { const int L[12] = {83,67,65,78,32,70,79,82,77,65,84,32}; return L[lc]; } // "SCAN FORMAT "
        if (item == 3) { const int L[12] = {65,83,80,69,67,84,32,82,65,84,73,79}; return L[lc]; } // "ASPECT RATIO"
        if (item == 4) { const int L[12] = {77,65,83,75,32,76,65,89,79,85,84,32}; return L[lc]; } // "MASK LAYOUT "
        if (item == 5) { const int L[12] = {67,76,69,65,82,69,68,71,69,32,86,77}; return L[lc]; } // "CLEAREDGE VM"
        if (item == 6) { const int L[12] = {72,45,66,69,65,77,32,66,76,69,78,68}; return L[lc]; } // "H-BEAM BLEND"
        if (item == 7) { const int L[12] = {86,45,66,69,65,77,32,83,73,71,77,65}; return L[lc]; } // "V-BEAM SIGMA"
        if (item == 8) { const int L[12] = {67,82,84,32,87,72,73,84,69,32,32,32}; return L[lc]; } // "CRT WHITE   "
        if (item == 9) { const int L[12] = {68,73,83,80,76,65,89,32,80,69,65,75}; return L[lc]; } // "DISPLAY PEAK"
    }
    if (c == 14) return 58;
    if (c == 15) return 32;

    int vc = c - 16;
    if (vc < 0 || vc > 8) return 32;

    if (item == 0) {
        if (pc.input_mode == 0u) { const int V[9] = {86,73,68,49,32,67,86,66,83}; return V[vc]; }
        if (pc.input_mode == 1u) { const int V[9] = {86,73,68,50,32,89,47,67,32}; return V[vc]; }
        const int V[9] = {86,73,68,52,32,67,79,77,80}; return V[vc];
    }
    if (item == 1) {
        if (pc.signal_standard == 0u) { const int V[9] = {78,84,83,67,32,54,48,72,90}; return V[vc]; }
        const int V[9] = {80,65,76,32,32,53,48,72,90}; return V[vc];
    }
    if (item == 2) {
        if (vc < 5) { const int P[5] = {80,82,79,71,32}, I[5] = {73,78,84,76,32}; return (pc.scan_format == 0u) ? P[vc] : I[vc]; }
        return format_scanlines_char(pc.scan_size.y, pc.scan_format, vc - 5);
    }
    if (item == 3) {
        if (pc.aspect_mode == 0u) { const int V[9] = {52,58,51,32,67,82,84,32,32}; return V[vc]; } // "4:3 CRT  "
        if (pc.aspect_mode == 1u) { const int V[9] = {49,54,58,57,32,87,73,68,69}; return V[vc]; } // "16:9 WIDE"
        const int V[9] = {70,85,76,76,32,87,73,78,32}; return V[vc];                               // "FULL WIN "
    }
    if (item == 4) {
        if (pc.mask_layout == 0u) { const int V[9] = {83,79,78,89,32,83,70,80,32}; return V[vc]; } // "SONY SFP "
        if (pc.mask_layout == 1u) { const int V[9] = {87,69,71,65,32,48,46,55,53}; return V[vc]; } // "WEGA 0.75"
        if (pc.mask_layout == 2u) { const int V[9] = {66,86,77,32,48,46,50,53,32}; return V[vc]; } // "BVM 0.25 "
        if (pc.mask_layout == 3u) { const int V[9] = {83,76,79,84,32,77,65,83,75}; return V[vc]; } // "SLOT MASK"
        const int V[9] = {68,79,84,32,84,82,73,79,32}; return V[vc];                               // "DOT TRIO "
    }
    if (item == 5) return format_float_char(pc.vm_strength, vc);
    if (item == 6) return format_float_char(pc.horiz_smear, vc);
    if (item == 7) return format_float_char(pc.beam_sigma_scale, vc);
    if (item == 9 && pc.output_mode < 0.5) { const int V[9] = {83,68,82,32,32,32,32,32,32}; return V[vc]; } // "SDR"
    if (item == 8 || item == 9) {
        if (vc < 4) return format_uint4_char(uint(item == 8 ? pc.crt_white_nits : pc.display_peak_nits), vc);
        const int U[5] = {32,78,73,84,83}; // " NITS"
        return U[vc - 4];
    }
    return 32;
}

int perf_char_at(int row, int col) {
    if (row == 0) {
        const int p0[4] = {70, 80, 83, 58}; // "FPS:"
        if (col >= 0 && col < 4) return p0[col];
        if (col >= 4 && col <= 8) return format_fps_char(pc.perf_fps, col - 4);
        const int p1[4] = {70, 82, 77, 58}; // "FRM:"
        if (col >= 11 && col < 15) return p1[col - 11];
        if (col >= 15 && col <= 19) return format_ms_char(pc.perf_frame_ms, col - 15);
        if (col == 20) return 77;
        if (col == 21) return 83;
    } else if (row == 1) {
        const int g0[4] = {71, 80, 85, 58}; // "GPU:"
        if (col >= 0 && col < 4) return g0[col];
        if (col >= 4 && col <= 8) return format_ms_char(pc.perf_gpu_ms, col - 4);
        if (col == 9)  return 77;
        if (col == 10) return 83;
        if (col >= 13 && col <= 16) return format_uint4_char(pc.raw_size.x, col - 13);
        if (col == 17) return 88;
        if (col >= 18 && col <= 21) return format_uint4_char(pc.raw_size.y, col - 18);
    } else if (row == 2) {
        uint w = pc.perf_overlay_on;
        const int b0[5] = {66, 69, 65, 77, 58}; // "BEAM:"
        if (col >= 0 && col < 5) return b0[col];
        const int st[16] = {79,70,70,32, 79,78,32,32, 72,69,76,68, 78,47,65,32}; // OFF ON HELD N/A
        if (col >= 5 && col < 9) return st[int((w >> 2u) & 3u) * 4 + col - 5];
        int hz = int((w >> 4u) & 255u);
        if (col == 10) return hz >= 100 ? 48 + hz / 100 : 32;
        if (col == 11) return hz >= 10 ? 48 + (hz / 10) % 10 : 32;
        if (col == 12) return 48 + hz % 10;
        if (col == 13) return 72;
        if (col == 14) return 90;
        const int d0[4] = {68, 82, 80, 58}; // "DRP:"
        if (col >= 16 && col < 20) return d0[col - 16];
        int d = int(min(w >> 12u, 99u));
        if (col == 20) return d >= 10 ? 48 + d / 10 : 32;
        if (col == 21) return 48 + d % 10;
    }
    return 32;
}

void evaluate_split_labels(vec2 uv, float split_x, bool raw_on_left, inout vec3 out_rgb) {
    if (abs(pc.split_wipe) < 0.001) return;

    vec2 raw_box_min = raw_on_left ? vec2(0.02, 0.02) : vec2(split_x + 0.02, 0.02);
    vec2 raw_box_max = raw_box_min + vec2(0.15, 0.035);
    if (uv.x >= raw_box_min.x && uv.x < raw_box_max.x && uv.y >= raw_box_min.y && uv.y < raw_box_max.y) {
        vec2 rel = (uv - raw_box_min) / (raw_box_max - raw_box_min);
        int col = int(rel.x * 11.0);
        vec2 cell = fract(rel * vec2(11.0, 1.0));
        int gx = int(cell.x * 10.5) - 1;
        int gy = int(cell.y * 11.0) - 1;
        const int L[11] = {82,65,87,32,78,69,65,82,69,83,84}; // "RAW NEAREST"
        out_rgb = mix(out_rgb, vec3(0.02, 0.05, 0.08), 0.85);
        int hit = (col >= 0 && col < 11) ? sample_outlined_glyph(L[col], gx, gy) : 0;
        if (hit == 2) out_rgb = vec3(0.0, 0.98, 0.80);
        else if (hit == 1) out_rgb = vec3(0.0);
    }
}

void evaluate_sony_wega_osd(vec2 uv, inout vec3 out_rgb) {
    if (pc.perf_overlay_on != 0u) {
        float rows = (pc.perf_overlay_on & 2u) != 0u ? 3.0 : 2.0;
        vec2 p_min = vec2(0.74, 0.985 - 0.035 * rows);
        vec2 p_max = vec2(0.985, 0.985);
        if (uv.x >= p_min.x && uv.x < p_max.x && uv.y >= p_min.y && uv.y < p_max.y) {
            vec2 rel = (uv - p_min) / (p_max - p_min);
            int col = int(rel.x * 22.0);
            int row = int(rel.y * rows);
            vec2 cell = fract(rel * vec2(22.0, rows));
            int gx = int(cell.x * 10.5) - 1;
            int gy = int(cell.y * 11.0) - 2;

            out_rgb = vec3(0.01, 0.03, 0.04);
            int ch = perf_char_at(row, col);
            int hit = sample_outlined_glyph(ch, gx, gy);
            if (hit == 2) {
                out_rgb = (row == 0) ? vec3(0.15, 1.00, 0.30) : vec3(1.00, 0.90, 0.20);
            } else if (hit == 1) {
                out_rgb = vec3(0.0);
            }
        }
    }

    if (pc.osd_mode == 0u) return;

    vec2 b_min = vec2(0.73, 0.045);
    vec2 b_max = vec2(0.96, 0.130);
    if (uv.x >= b_min.x && uv.x < b_max.x && uv.y >= b_min.y && uv.y < b_max.y) {
        vec2 rel = (uv - b_min) / (b_max - b_min);
        int col = int(rel.x * 13.0);
        int row = int(rel.y * 2.0);
        vec2 cell = fract(rel * vec2(13.0, 2.0));
        int gx = int(cell.x * 10.5) - 1;
        int gy = int(cell.y * 11.0) - 1;
        int ch = banner_char_at(row, col);

        out_rgb = mix(out_rgb, vec3(0.01, 0.03, 0.04), 0.78);
        int hit = sample_outlined_glyph(ch, gx, gy);
        if (hit == 2) {
            out_rgb = vec3(0.12, 0.98, 0.22);
        } else if (hit == 1) {
            out_rgb = vec3(0.0);
        }
    }

    if (pc.osd_mode == 2u) {
        vec2 m_min = vec2(0.035, 0.065);
        vec2 m_max = vec2(0.515, 0.676);
        if (uv.x >= m_min.x && uv.x < m_max.x && uv.y >= m_min.y && uv.y < m_max.y) {
            vec2 rel = (uv - m_min) / (m_max - m_min);
            int col = int(rel.x * 28.0);
            int row = int(rel.y * 12.0);
            vec2 cell = fract(rel * vec2(28.0, 12.0));
            int gx = int(cell.x * 10.5) - 1;
            int gy = int(cell.y * 11.0) - (row == 0 ? 2 : 1);

            bool is_border = (rel.x < 0.010 || rel.x > 0.990 || rel.y < 0.011 || rel.y > 0.989);
            if (is_border) {
                out_rgb = vec3(0.12, 0.82, 0.32);
                return;
            }

            bool is_selected_row = (row >= 1 && row <= 10 && uint(row - 1) == pc.osd_selected_row);
            vec3 panel_bg = is_selected_row ? vec3(0.05, 0.16, 0.22) : vec3(0.02, 0.04, 0.07);
            out_rgb = mix(out_rgb, panel_bg, 0.93);

            int ch = menu_char_at(row, col);
            int hit = sample_outlined_glyph(ch, gx, gy);
            if (hit == 2) {
                if (row == 0) {
                    out_rgb = vec3(1.00, 0.84, 0.18);
                } else if (row == 11) {
                    out_rgb = vec3(0.65, 0.88, 0.98);
                } else if (is_selected_row) {
                    out_rgb = vec3(1.00, 1.00, 0.30);
                } else {
                    out_rgb = vec3(0.18, 0.96, 0.28);
                }
                if (row == 10 && pc.output_mode < 0.5) out_rgb *= 0.65;
            } else if (hit == 1) {
                out_rgb = vec3(0.0);
            }
        }
    }
}

vec2 map_window_to_crt_uv(vec2 win_uv, out bool in_bezel) {
    float win_aspect = float(pc.output_size.x) / float(max(pc.output_size.y, 1u));
    bool is_tate = (pc.raw_size.y > pc.raw_size.x);
    float target_aspect = win_aspect;
    if (pc.aspect_mode == 0u) {
        target_aspect = is_tate ? (3.0 / 4.0) : (4.0 / 3.0);
    } else if (pc.aspect_mode == 1u) {
        target_aspect = is_tate ? (9.0 / 16.0) : (16.0 / 9.0);
    }
    vec2 tube_uv = win_uv;
    if (win_aspect > target_aspect) {
        float scale_x = win_aspect / target_aspect;
        tube_uv.x = (win_uv.x - 0.5) * scale_x + 0.5;
    } else if (win_aspect < target_aspect) {
        float scale_y = target_aspect / win_aspect;
        tube_uv.y = (win_uv.y - 0.5) * scale_y + 0.5;
    }
    in_bezel = any(lessThan(tube_uv, vec2(0.0))) || any(greaterThan(tube_uv, vec2(1.0)));
    return tube_uv;
}

// ============================================================================
// Sub-Pixel Phosphor Response, Non-Linear Saturation & Lumina Expansion
// ============================================================================
// Evaluates the physical electron beam hitting each individual R, G, and B phosphor sub-pixel
// stripe at its exact horizontal coordinate (u_r, u_g, u_b), modeling:
//   1. Compound-specific cathodoluminescence activator saturation:
//      Red (Y2O2S:Eu3+, k=0.06), Green (ZnS:Cu,Al, k=0.14), Blue (ZnS:Ag,Cl, k=0.22).
//   2. Per-channel vertical lumina expansion:
//      Each channel's vertical Gaussian waist sigma_y(L_c) expands independently with its
//      excited luminance L_c, so dark scanlines have deep black grooves while bright white/cyan
//      scanlines bloom vertically across the scanline gap!
//   3. Horizontal lumina expansion across the aperture grille black carbon matrix:
//      Strongly driven phosphor stripes expand their effective emission duty cycle across the
//      black matrix guard band and radiate internal crystal halation into adjacent triad slots.
#ifdef KD30_WEB
#define KD_CUR  false
#define KD_PREV true
vec3 sample_subpixel_phosphor_line(bool prev, float u_r, float u_g, float u_b, float y_line) {
    vec3 E_gun;
    if (prev) E_gun = vec3(texture(uScanlinePrevTex, vec2(u_r, y_line)).r, texture(uScanlinePrevTex, vec2(u_g, y_line)).g,
                           texture(uScanlinePrevTex, vec2(u_b, y_line)).b);
    else E_gun = vec3(texture(uScanlineTex, vec2(u_r, y_line)).r, texture(uScanlineTex, vec2(u_g, y_line)).g,
                      texture(uScanlineTex, vec2(u_b, y_line)).b);
#else
#define KD_CUR  uScanlineTex
#define KD_PREV uScanlinePrevTex
vec3 sample_subpixel_phosphor_line(sampler2D tex, float u_r, float u_g, float u_b, float y_line) {
    vec3 E_gun = vec3(
        texture(tex, vec2(u_r, y_line)).r,
        texture(tex, vec2(u_g, y_line)).g,
        texture(tex, vec2(u_b, y_line)).b
    );
#endif
    // Non-linear P22 cathodoluminescence activator saturation
    const vec3 k_sat = vec3(0.06, 0.14, 0.22);
    vec3 over = max(E_gun - 1.0, vec3(0.0));
    return min(E_gun, vec3(1.0)) + over / (1.0 + k_sat * over);
}

const float TUBE_H_MM = 355.0;

const vec3 P22_FAST_FRAC = vec3(0.90, 0.85, 0.90);
const vec3 P22_TAU_FAST  = vec3(1.00, 0.06, 0.03);
const vec3 P22_TAU_SLOW  = vec3(4.00, 3.00, 2.00);

const float GRAPHICS_WHITE_NITS = 203.0;

vec3 beam_sigma_mm(vec3 L) {
    return vec3(0.28) + 0.30 * pow(clamp(L, vec3(0.0), vec3(1.5)), vec3(0.70));
}

// Widest spot, as a fraction of the line pitch, that still leaves a dark gap between lines
// (dark drive, full drive): tight on a BVM, softest on a dot mask.
vec2 spot_gap_ratio(uint mask) {
    if (mask == 1u) return vec2(0.22, 0.40);
    if (mask == 2u) return vec2(0.17, 0.33);
    if (mask == 3u) return vec2(0.24, 0.42);
    if (mask == 4u) return vec2(0.25, 0.44);
    return vec2(0.20, 0.38);
}

vec3 spot_sigma_mm(vec3 L, float pitch_mm, float waist) {
    vec2  r   = spot_gap_ratio(pc.mask_layout);
    vec3  b   = pow(clamp(L, vec3(0.0), vec3(1.5)), vec3(0.70));
    vec3  cap = pitch_mm * (r.x + (r.y - r.x) * min(b, vec3(1.0)));
    return min((vec3(0.28) + 0.30 * b) * waist, cap) * pc.beam_sigma_scale;
}

// Light of one excitation emitted from 0 to t ms after it; past 8 ms only the slow tails remain.
vec3 p22_cumulative(float t) {
    if (t >= 8.0) return vec3(1.0) - (1.0 - P22_FAST_FRAC) * exp(-vec3(t) / P22_TAU_SLOW);
    vec3 t3 = vec3(max(t, 0.0));
    return P22_FAST_FRAC * (1.0 - exp(-t3 / P22_TAU_FAST)) + (1.0 - P22_FAST_FRAC) * (1.0 - exp(-t3 / P22_TAU_SLOW));
}

// Light a refresh shows of a pass m refreshes back (scaled by g, the excitation's light per refresh
// it would get if spread evenly), when the display can show at most cap per refresh: s0 and s1 are
// what the pass has emitted by the start and end of this refresh, sf by the end of its own.
// Light that doesn't fit is carried to the following refreshes, so a line's total light doesn't
// depend on where the refreshes fall: by the end of a refresh no more is shown than emitted, than
// cap per refresh since the pass, nor than its own refresh showed plus cap per refresh after it.
vec3 carried_share(float m, vec3 s0, vec3 s1, vec3 sf, vec3 cap) {
    if (m < 0.5) return min(cap, s1);
    return min(min((m + 1.0) * cap, s1), sf + m * cap) - min(min(m * cap, s0), sf + (m - 1.0) * cap);
}

// Most light one refresh can show, in drive units (1.0 = flat full-drive field).
float display_cap() {
    if (pc.output_mode < 0.5) return 1.0;
    return max(pc.display_peak_nits / GRAPHICS_WHITE_NITS, 1.0) * GRAPHICS_WHITE_NITS / max(pc.crt_white_nits, 1.0);
}

// Aperture mask as a factor on the beam's light; stripes and dots widen with the beam level.
vec3 mask_factor(vec3 level, float effective_zoom, float total_triads, float inst_freq_scale, float triad_coord,
                 float triad_idx, float triad_phase, float scan_y_for_mask) {
    // Evaluate Selected Phosphor Grille / Mask Layout (0..4) with Horizontal Lumina Expansion:
    float effective_res_x = float(pc.output_size.x) * max(effective_zoom, 1.0);
    float d_triad = (total_triads * inst_freq_scale) / effective_res_x;
    float macro_blend = clamp((effective_zoom - 1.5) / 4.0, 0.0, 1.0);

    if (pc.mask_layout <= 2u) {
        // Horizontal Lumina Expansion: strongly excited phosphor stripes expand their effective
        // crystal duty cycle across the black carbon guard band (from 0.24 at dark up to 0.38 at peak)!
        vec3 duty = clamp(vec3(0.24) + 0.14 * pow(clamp(level, vec3(0.0), vec3(1.4)), vec3(0.75)), vec3(0.23), vec3(0.39));
        // On a striped panel each colour is shown by its own subpixel: evaluate the stripes there,
        // box-filtered over that subpixel, keeping each harmonic below the subpixel sampling limit.
        bool  subpx   = pc.subpixel_layout > 0.5;
        vec3  sub_off = pc.subpixel_layout > 1.5 ? vec3(0.3333333, 0.0, -0.3333333)
                      : (subpx ? vec3(-0.3333333, 0.0, 0.3333333) : vec3(0.0));
        vec3  tphase  = fract(vec3(triad_coord) + sub_off * d_triad);
        vec3 phases1 = 6.28318530 * (tphase - vec3(0.1666667, 0.5000000, 0.8333333));
        vec3 phases2 = 2.0 * phases1;
        vec3 phases3 = 3.0 * phases1;

        float px_sinc1, px_sinc2, px_sinc3;
        if (subpx) {
            float w = 3.14159265 * d_triad / 3.0;
            px_sinc1 = (sin(w) / max(w, 1e-4)) * smoothstep(0.50, 0.36, d_triad);
            px_sinc2 = (sin(2.0 * w) / max(2.0 * w, 1e-4)) * smoothstep(0.25, 0.18, d_triad);
            px_sinc3 = (sin(3.0 * w) / max(3.0 * w, 1e-4)) * smoothstep(0.1667, 0.12, d_triad);
        } else {
            float p_arg1 = 3.14159265 * min(d_triad, 1.0);
            float p_arg2 = 6.28318530 * min(d_triad, 0.5);
            float p_arg3 = 9.42477796 * min(d_triad, 0.3333);
            px_sinc1 = (sin(p_arg1) / max(p_arg1, 1e-4)) * smoothstep(0.92, 0.18, d_triad);
            px_sinc2 = (sin(p_arg2) / max(p_arg2, 1e-4)) * smoothstep(0.50, 0.14, d_triad);
            px_sinc3 = (sin(p_arg3) / max(p_arg3, 1e-4)) * smoothstep(0.33, 0.09, d_triad);
        }

        vec3 st_sinc1 = (sin(3.14159265 * duty) / (3.14159265 * duty)) * 0.9003;
        vec3 st_sinc2 = (sin(6.28318530 * duty) / (6.28318530 * duty)) * 0.6366;
        vec3 st_sinc3 = (sin(9.42477796 * duty) / (9.42477796 * duty)) * 0.3001;

        // Unified analytical box-filtered Fourier series of the [R | Dag | G | Dag | B | Dag] stripes:
        vec3 grille_full = max(vec3(0.0), vec3(1.0)
                         + 2.0 * st_sinc1 * px_sinc1 * cos(phases1)
                         + 2.0 * st_sinc2 * px_sinc2 * cos(phases2)
                         + 2.0 * st_sinc3 * px_sinc3 * cos(phases3));

        // Intra-triad phosphor crystal scatter (high-energy excitation in one stripe scatters light into the triad)
        float triad_luma = dot(level, vec3(0.299, 0.587, 0.114));

        // At 1x scale, blend between gentle eye-integrated triad contrast and full macro stripes based on pixel density
        float grille_strength_1x = pc.mask_strength > 0.0 ? pc.mask_strength
                                 : ((pc.mask_layout == 1u) ? 0.38 : ((pc.mask_layout == 2u) ? 0.18 : 0.28));
        float blend_to_full = mix(grille_strength_1x, 1.0, macro_blend);
        vec3 eff_grille = mix(vec3(1.0), grille_full, blend_to_full);

        return eff_grille + (0.16 + 0.24 * clamp(level + vec3(triad_luma * 0.35), vec3(0.0), vec3(1.0))) * (0.25 * blend_to_full);
    } else if (pc.mask_layout == 3u) {
        vec3 phases1 = 6.28318530 * (triad_phase - vec3(0.1666667, 0.5000000, 0.8333333));
        float p_arg1 = 3.14159265 * min(d_triad, 1.0);
        float px_sinc1 = (sin(p_arg1) / max(p_arg1, 1e-4)) * smoothstep(0.90, 0.20, d_triad);

        float col_parity = mod(triad_idx, 2.0);
        float slot_v = fract(scan_y_for_mask * 0.5 + col_parity * 0.5);
        float bridge = 1.0 - (0.32 + 0.38 * macro_blend) * exp(-pow((slot_v - 0.5) / 0.14, 4.0));

        vec3 slot_rgb = vec3(0.88) + (0.30 + 0.55 * macro_blend) * px_sinc1 * cos(phases1);
        slot_rgb = max(vec3(0.08), slot_rgb) * bridge;
        vec3 mask_f = mix(slot_rgb, vec3(1.0), clamp(level * 0.38, 0.0, 0.55));
        return mask_f;
    } else {
        float dot_rows    = scan_y_for_mask / 0.8660254;
        float row_stagger = mod(floor(dot_rows), 2.0) * 0.5;
        float dot_triad_x = fract(triad_coord + row_stagger);
        float dot_y       = fract(dot_rows) - 0.5;

        vec3 dx = abs(vec3(dot_triad_x) - vec3(0.1666667, 0.5000000, 0.8333333)) * 3.0;
        vec3 r2 = dx * dx + vec3(dot_y * dot_y * 6.75);
        vec3 dots = exp(-pow(r2 / (0.40 + 0.18 * clamp(level, vec3(0.0), vec3(1.0))), vec3(1.8)));

        float dot_vis = smoothstep(0.90, 0.20, d_triad) * (0.35 + 0.58 * macro_blend);
        vec3 dot_mask = mix(vec3(1.0), dots * 1.65, dot_vis);
        return dot_mask;
    }
}

// Beam timing of scan line k for this refresh: whether it still shows the previous picture, the
// refreshes since its latest pass (m), and that pass's light by the end of this refresh (s1). For a
// line passed during this refresh, sa and sb are the pass before's light by the start and end of it;
// otherwise the latest pass's by the start of this refresh and by the end of its own.
struct LineTiming { float m; bool prev; vec3 s1; vec3 sa; vec3 sb; };

LineTiming line_timing(int k) {
    bool  interlaced = pc.scan_format != 0u;
    float W      = pc.window_ms;
    float period = (interlaced ? 2.0 : 1.0) * pc.field_ms;
    float g      = period / W;
    float v      = (float(k) + 0.5) / float(pc.scan_size.y);
    LineTiming t;
    t.prev   = interlaced && (k & 1) != int(pc.frame_count & 1u);
    float te = pc.cur_start_ms + v * pc.field_ms * 0.92 - (t.prev ? pc.field_ms : 0.0);
    if (te >= W) { te -= period; t.prev = true; }
    t.m  = max(0.0, -floor(te / W));
    t.s1 = g * p22_cumulative(W - te);
    if (t.m < 0.5) {
        t.sa = g * p22_cumulative(period - te);
        t.sb = g * p22_cumulative(period + W - te);
    } else {
        t.sa = g * p22_cumulative(-te);
        t.sb = t.m < 1.5 ? t.sa : g * p22_cumulative(W - (te + t.m * W));
    }
    return t;
}

// The tube's position after the high-voltage breathing, as evaluate_crt_raster_at places it.
vec2 breathing_uv(vec2 uv_in) {
    float num_lines    = float(pc.scan_size.y);
    float line_idx_raw = clamp(floor(uv_in.y * num_lines), 0.0, num_lines - 1.0);
    float line_curr    = texture(uScanlineTex, vec2(0.5, (line_idx_raw + 0.5) / num_lines)).a;
    float frame_curr   = texture(uScanlineTex, vec2(0.5, 0.5)).a;
    float hv_sag       = mix(frame_curr, line_curr, 0.65) * pc.hv_breathing;
    return (uv_in - 0.5) / (1.0 + hv_sag) + 0.5;
}

// Line timing depends only on the line, so each workgroup works it out once for the lines its rows
// cover (rows map to lines independently of x).
const int KD_TABLE = 48;
shared int   tl_rowk[16];
shared float tl_m[KD_TABLE];
shared float tl_prev[KD_TABLE];
shared vec3  tl_s1[KD_TABLE];
shared vec3  tl_sa[KD_TABLE];
shared vec3  tl_sb[KD_TABLE];
int tl_base  = 0;
int tl_count = 0;

void fill_line_table(vec2 tube_uv) {
    if (gl_LocalInvocationID.x == 0u) {
        float y = breathing_uv(tube_uv).y;
        tl_rowk[gl_LocalInvocationID.y] = (y < 0.0 || y > 1.0) ? -1 : int(floor(y * float(pc.scan_size.y)));
    }
    barrier();
    int kmin = 0x7fffffff, kmax = -1;
    for (int r = 0; r < 16; r++) {
        int k = tl_rowk[r];
        if (k >= 0) { kmin = min(kmin, k); kmax = max(kmax, k); }
    }
    tl_base  = kmin - 2;
    tl_count = kmax >= kmin ? min(kmax - kmin + 5, KD_TABLE) : 0;
    int i = int(gl_LocalInvocationIndex);
    if (i < tl_count) {
        LineTiming t = line_timing(tl_base + i);
        tl_m[i]    = t.m;
        tl_prev[i] = t.prev ? 1.0 : 0.0;
        tl_s1[i]   = t.s1;
        tl_sa[i]   = t.sa;
        tl_sb[i]   = t.sb;
    }
    barrier();
}

// One scan line's light at a point, from the picture its latest pass showed.
vec3 line_light(int k, bool prev, float y_lines, float pitch_mm, float waist, float u_r, float u_g, float u_b) {
    if (k < 0 || k >= int(pc.scan_size.y)) return vec3(0.0);
    float v = (float(k) + 0.5) / float(pc.scan_size.y);
    float d = (y_lines - (float(k) + 0.5)) * pitch_mm;
    vec3  L;
    if (prev) L = sample_subpixel_phosphor_line(KD_PREV, u_r, u_g, u_b, v);
    else      L = sample_subpixel_phosphor_line(KD_CUR, u_r, u_g, u_b, v);
    vec3 sg = spot_sigma_mm(L, pitch_mm, waist);
    return L * (pitch_mm / (2.5066283 * sg)) * exp(-0.5 * d * d / (sg * sg));
}

bool line_prev(int k) {
    int i = k - tl_base;
    return i >= 0 && i < tl_count && tl_prev[i] > 0.5;
}

// What scan line k shows of its light a during this refresh, at most cap. A line passed during this
// refresh also shows what is left of the pass before, which fell at the same point of its own refresh;
// lines the table doesn't cover (a tiny output) show their steady light.
vec3 line_share(int k, vec3 a, vec3 cap, float mp) {
    if (max(a.r, max(a.g, a.b)) <= 0.0) return vec3(0.0);
    int i = k - tl_base;
    if (i < 0 || i >= tl_count) return a;
    vec3  c  = cap / max(a, vec3(1e-4));
    float m  = tl_m[i];
    vec3  s1 = tl_s1[i], sa = tl_sa[i], sb = tl_sb[i];
    vec3  w  = m < 0.5 ? min(c, s1) + carried_share(mp, sa, sb, s1, c) : carried_share(m, sa, s1, sb, c);
    return min(w * a, cap);
}

vec3 evaluate_crt_raster_at(vec2 uv_in, float effective_zoom, bool use_table, out vec3 out_sustained_rgb) {
    float num_lines = float(pc.scan_size.y);
    vec2 uv = breathing_uv(uv_in);
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        out_sustained_rgb = vec3(0.0);
        return vec3(0.0);
    }

    float eff_pitch_mm = pc.sfp_pitch_mm;
    float bvm_waist_scale = 1.0;
    bool  has_damper_wires = true;

    if (pc.mask_layout == 1u) {
        eff_pitch_mm = max(pc.sfp_pitch_mm, 0.72); // Consumer WEGA (~1.5 triads per Genesis pixel)
    } else if (pc.mask_layout == 2u) {
        eff_pitch_mm = 0.30;                       // Sony BVM-D24 Master Monitor (~3.0 triads per pixel)
        bvm_waist_scale = 0.82;
    } else if (pc.mask_layout == 3u) {
        eff_pitch_mm = 0.62;                       // Staggered Slot Mask
        has_damper_wires = false;
    } else if (pc.mask_layout == 4u) {
        eff_pitch_mm = 0.56;                       // Staggered Dot-Trio Shadow Mask
        has_damper_wires = false;
    }

    float u_sym = uv.x * 2.0 - 1.0;
    const float alpha_edge = 0.065;
    float x_grille = 0.5 + 0.5 * (u_sym - (alpha_edge / 3.0) * u_sym * u_sym * u_sym) / (1.0 - alpha_edge / 3.0);
    float inst_freq_scale = (1.0 - alpha_edge * u_sym * u_sym) / (1.0 - alpha_edge / 3.0);

    // Calibrated physical triad count across the 4:3 active raster:
    // At 0.45mm SFP pitch -> ~640 triads (~2.0 RGB triads = 6 sub-pixel phosphor stripes per 320px column);
    // At 0.72mm WEGA pitch -> ~480 triads (~1.5 RGB triads per 320px column, matching macro CRT photos!)
    float raster_w_mm  = TUBE_H_MM * ((pc.aspect_mode == 1u) ? (16.0 / 9.0) : (4.0 / 3.0));
    float total_triads = raster_w_mm / max(eff_pitch_mm, 0.18);
    float triad_coord  = x_grille * total_triads;
    float triad_idx    = floor(triad_coord);
    float triad_phase  = triad_coord - triad_idx;

    // Exact sub-pixel horizontal coordinates of the nearest Red (1/6), Green (3/6), and Blue (5/6) phosphor stripes:
    float near_r_idx = floor(triad_coord - 0.1666667 + 0.5) + 0.1666667;
    float near_g_idx = floor(triad_coord - 0.5000000 + 0.5) + 0.5000000;
    float near_b_idx = floor(triad_coord - 0.8333333 + 0.5) + 0.8333333;
    float u_r = clamp(near_r_idx / total_triads, 0.0, 1.0);
    float u_g = clamp(near_g_idx / total_triads, 0.0, 1.0);
    float u_b = clamp(near_b_idx / total_triads, 0.0, 1.0);

    // Raster: one beam trace per source line (progressive: all lines each field; interlaced: the
    // source frame is the weave of the last two fields, so each line sits at its frame position).
    // Spot size is physical (mm on the tube); each trace is energy-normalised so a flat field
    // averages to the drive level regardless of spot size or line pitch.
    float scan_y_for_mask = uv.y * TUBE_H_MM / max(eff_pitch_mm, 0.18);
    float pitch_mm = TUBE_H_MM / num_lines;
    float y_lines  = uv.y * num_lines;
    int   k0       = int(floor(y_lines));
    bool  interlaced = (pc.scan_format != 0u);
    // Beam: a line lights as the beam passes it and then decays, so each refresh shows the lines
    // scanned during it bright and the others fading. The beam passes a line every field, or every
    // other field when interlaced: there the other field's lines are the previous field decaying.
    // The magnifier shows the time-averaged picture. A spot is at most 0.44 of the line pitch wide
    // unless its size is raised, so lines 1.5 pitches away add under 0.3%: three lines reach a point.
    bool  timed = KD_BEAM && use_table && pc.window_ms > 0.0 && pc.field_ms > 0.0;
    bool  wide  = pc.beam_sigma_scale > 1.15;
    float waist = bvm_waist_scale;
    vec3  scanline_rgb = vec3(0.0);
    vec3  M;
    if (!timed) {
        int reach = wide ? 2 : 1;
        for (int j = -reach; j <= reach; j++)
            scanline_rgb += line_light(k0 + j, false, y_lines, pitch_mm, waist, u_r, u_g, u_b);
        M = mask_factor(scanline_rgb, effective_zoom, total_triads, inst_freq_scale, triad_coord, triad_idx, triad_phase,
                        scan_y_for_mask);
    } else {
        // Each line as its latest pass left it: lines the beam hasn't reached yet, and when
        // interlaced the other field's, still show the previous picture.
        vec3 a0 = line_light(k0 - 1, line_prev(k0 - 1), y_lines, pitch_mm, waist, u_r, u_g, u_b);
        vec3 a1 = line_light(k0,     line_prev(k0),     y_lines, pitch_mm, waist, u_r, u_g, u_b);
        vec3 a2 = line_light(k0 + 1, line_prev(k0 + 1), y_lines, pitch_mm, waist, u_r, u_g, u_b);
        vec3 b0 = vec3(0.0), b1 = vec3(0.0);
        if (wide) {
            b0 = line_light(k0 - 2, line_prev(k0 - 2), y_lines, pitch_mm, waist, u_r, u_g, u_b);
            b1 = line_light(k0 + 2, line_prev(k0 + 2), y_lines, pitch_mm, waist, u_r, u_g, u_b);
        }
        M = mask_factor(a0 + a1 + a2 + b0 + b1, effective_zoom, total_triads, inst_freq_scale, triad_coord, triad_idx, triad_phase,
                        scan_y_for_mask);
        // Most a refresh can show here before the mask: the output's knee over the colour matrix
        // and the mask's gain.
        vec3  cap = 0.76 * display_cap() / max(M, vec3(0.05));
        float mp  = (interlaced ? 2.0 : 1.0) * pc.field_ms / pc.window_ms;
        scanline_rgb = line_share(k0 - 1, a0, cap, mp) + line_share(k0, a1, cap, mp) + line_share(k0 + 1, a2, cap, mp);
        if (wide) scanline_rgb += line_share(k0 - 2, b0, cap, mp) + line_share(k0 + 2, b1, cap, mp);
    }
    out_sustained_rgb = scanline_rgb;

    vec3 beam = scanline_rgb * M;
    out_sustained_rgb = out_sustained_rgb * M;

    if (has_damper_wires) {
        float w_top = exp(-pow((uv.y - 0.315) * float(pc.output_size.y) / 1.10, 2.0));
        float w_bot = exp(-pow((uv.y - 0.685) * float(pc.output_size.y) / 1.10, 2.0));
        float d_atten = 1.0 - pc.damper_str * max(w_top, w_bot);
        beam              *= d_atten;
        out_sustained_rgb *= d_atten;
    }

    if (pc.signal_standard == 0u) {
        const mat3 sony_ntsc_p22 = mat3(
            1.05, -0.03, -0.02,
           -0.02,  1.03, -0.01,
           -0.01, -0.02,  1.04
        );
        beam              = max(vec3(0.0), sony_ntsc_p22 * beam);
        out_sustained_rgb = max(vec3(0.0), sony_ntsc_p22 * out_sustained_rgb);
    } else {
        const mat3 sony_pal_ebu = mat3(
            1.02, -0.01, -0.01,
           -0.01,  1.02, -0.01,
            0.00, -0.01,  1.01
        );
        beam              = max(vec3(0.0), sony_pal_ebu * beam);
        out_sustained_rgb = max(vec3(0.0), sony_pal_ebu * out_sustained_rgb);
    }

    return beam;
}

// ============================================================================
// Continuous-Time Compound-Specific P22 Phosphor Persistence Reservoir
// ============================================================================
// P22 decays to well under 1% within one 16.7 ms field; with B the other field's lines of an
// interlaced scan are that decay, so they go dark until the beam returns.
vec3 encode_chromaticity_preserving_output(vec3 linear_rgb, float headroom) {
    vec3 c = max(linear_rgb, vec3(0.0));
    float h = max(headroom, 1.0);
    float knee = 0.8 * h;
    float peak = max(c.r, max(c.g, c.b));
    if (peak > knee) {
        float span = h - knee;
        c *= (knee + span * (1.0 - exp(-(peak - knee) / span))) / peak;
    }
    return pow(c, vec3(1.0 / 2.2));
}

// CRT light (drive units, 1.0 = flat full-drive field) -> working value (sRGB-shaped, may exceed 1 in HDR)
vec3 encode_crt(vec3 lin) {
    if (pc.output_mode < 0.5) return encode_chromaticity_preserving_output(lin, 1.0);
    float scale = pc.crt_white_nits / GRAPHICS_WHITE_NITS;
    return encode_chromaticity_preserving_output(lin * scale, max(pc.display_peak_nits / GRAPHICS_WHITE_NITS, 1.0));
}

vec3 pq_encode(vec3 nits) {
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), vec3(78.84375));
}

vec4 to_swapchain(vec3 working) {
    if (pc.output_mode < 0.5) return vec4(clamp(working, 0.0, 1.0), 1.0);
    vec3 rel = pow(max(working, vec3(0.0)), vec3(2.2));
    if (pc.output_mode < 1.5) return vec4(rel * (GRAPHICS_WHITE_NITS / pc.sdr_ref_nits), 1.0);
    const mat3 bt709_to_2020 = mat3(0.6274, 0.0691, 0.0164,
                                    0.3293, 0.9195, 0.0880,
                                    0.0433, 0.0114, 0.8956);
    return vec4(pq_encode(max(bt709_to_2020 * rel, vec3(0.0)) * GRAPHICS_WHITE_NITS), 1.0);
}

// First-order panel response: choose the drive so the light the panel emits over this refresh
// equals the CRT light integrated over the same interval. Panel state lives in uTemporalAccum.
vec3 compensate_panel(vec3 target, ivec2 px) {
#ifdef KD30_WEB
    return target;
#else
    if (pc.window_ms <= 0.0 || pc.panel_tau_ms < 0.05) return target;
    vec3 y0 = imageLoad(uTemporalAccum, px).rgb;
    float e = exp(-pc.window_ms / pc.panel_tau_ms);
    float k = pc.panel_tau_ms * (1.0 - e) / pc.window_ms;
    float peak = (pc.output_mode < 0.5) ? 1.0 : pc.display_peak_nits / max(pc.crt_white_nits, 1.0);
    float gain = min(k / max(1.0 - k, 1e-3), 1.0);
    vec3 drive = clamp(target + gain * (target - y0), vec3(0.0), vec3(peak));
    imageStore(uTemporalAccum, px, vec4(drive + (y0 - drive) * e, 0.0));
    return drive;
#endif
}

vec3 sample_raw_nearest(vec2 uv) {
    ivec2 raw_sz = textureSize(uRawWindowTex, 0);
    ivec2 raw_px = clamp(ivec2(floor(uv * vec2(raw_sz))), ivec2(0), raw_sz - ivec2(1));
    return texelFetch(uRawWindowTex, raw_px, 0).rgb;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    vec2 win_uv = (vec2(px) + 0.5) / vec2(pc.output_size);
    bool in_bezel = false;
    vec2 tube_uv = map_window_to_crt_uv(win_uv, in_bezel);
    if (KD_BEAM && pc.window_ms > 0.0 && pc.field_ms > 0.0) fill_line_table(tube_uv);
    if (px.x >= int(pc.output_size.x) || px.y >= int(pc.output_size.y)) return;

    vec3 final_srgb = vec3(0.0);
    float field_tag = float(pc.frame_count & 255u);

    if (!in_bezel) {
        vec3 sustained_rgb = vec3(0.0);
        vec3 crt_linear = evaluate_crt_raster_at(tube_uv, 1.0, true, sustained_rgb);
        final_srgb = encode_crt(compensate_panel(crt_linear, px));

        if (abs(pc.split_wipe) > 0.001) {
            float split_x = abs(pc.split_wipe);
            bool raw_on_left = (pc.split_wipe > 0.0);
            bool is_raw_side = raw_on_left ? (tube_uv.x < split_x) : (tube_uv.x > split_x);

            if (is_raw_side) {
                final_srgb = sample_raw_nearest(tube_uv);
            }

            evaluate_split_labels(tube_uv, split_x, raw_on_left, final_srgb);

            float dist_px = abs(tube_uv.x - split_x) * float(pc.output_size.x);
            if (dist_px < 1.4) {
                final_srgb = vec3(0.0, 1.0, 0.75);
            } else if (dist_px < 2.8) {
                final_srgb *= 0.15;
            }
        }
    }

    if (pc.zoom_factor > 1.05) {
        vec2 zoom_center = vec2(pc.zoom_center_x, pc.zoom_center_y);
        float aspect = float(pc.output_size.x) / float(pc.output_size.y);
        vec2 delta = win_uv - zoom_center;
        vec2 delta_aspect = vec2(delta.x * aspect, delta.y);
        float radius = 0.24;
        float dist = length(delta_aspect);

        if (dist <= radius) {
            vec2 zoomed_win_uv = clamp(zoom_center + delta / pc.zoom_factor, vec2(0.0), vec2(1.0));
            bool zoom_bezel = false;
            vec2 zoomed_tube_uv = map_window_to_crt_uv(zoomed_win_uv, zoom_bezel);
            vec3 loupe_srgb = vec3(0.0);

            if (!zoom_bezel) {
                vec3 loupe_sustained = vec3(0.0);
                vec3 loupe_crt_lin = evaluate_crt_raster_at(zoomed_tube_uv, pc.zoom_factor, false, loupe_sustained);
                loupe_srgb = encode_crt(loupe_crt_lin);

                if (abs(pc.split_wipe) > 0.001) {
                    float split_x = abs(pc.split_wipe);
                    bool raw_on_left = (pc.split_wipe > 0.0);
                    bool is_raw = raw_on_left ? (zoomed_tube_uv.x < split_x) : (zoomed_tube_uv.x > split_x);
                    if (is_raw) {
                        loupe_srgb = sample_raw_nearest(zoomed_tube_uv);
                    }
                }
            }
            final_srgb = loupe_srgb;
            if (dist > radius - 0.005) {
                final_srgb = vec3(0.15, 0.95, 0.45);
            }
        }
    }

    evaluate_sony_wega_osd(win_uv, final_srgb);
    imageStore(uOutputFrame, px, to_swapchain(final_srgb));
}
