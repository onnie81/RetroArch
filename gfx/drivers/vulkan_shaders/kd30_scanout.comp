#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Beam timing (B) and the steady scanout are separate pipelines, so the steady one carries no beam code.
#if defined(KD30_WEB) && defined(KD30_BEAM)
const bool KD_BEAM = true;
#elif defined(KD30_WEB)
const bool KD_BEAM = false;
#else
layout(constant_id = 0) const bool KD_BEAM = false;
#endif

#ifdef KD30_WEB
layout(set = 0, binding = 0) uniform texture2D uScanTex;
layout(set = 0, binding = 2) uniform texture2D uRawTex;
layout(set = 0, binding = 4) uniform texture2D uScanPrevTex;
layout(set = 0, binding = 5) uniform sampler uSamp;
#define uScanlineTex sampler2D(uScanTex, uSamp)
#define uRawWindowTex sampler2D(uRawTex, uSamp)
#define uScanlinePrevTex sampler2D(uScanPrevTex, uSamp)
#else
layout(set = 0, binding = 0) uniform sampler2D uScanlineTex;
layout(set = 0, binding = 2) uniform sampler2D uRawWindowTex;
// Stateful P22 phosphor reservoir: .rgb = excited phosphor luminance, .a = last broadcast field tag
layout(set = 0, binding = 3, rgba16f) uniform image2D uTemporalAccum;
layout(set = 0, binding = 4) uniform sampler2D uScanlinePrevTex;
#endif
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uOutputFrame;

#ifdef KD30_WEB
layout(set = 0, binding = 6, std140) uniform ScanoutPush {
#else
layout(push_constant) uniform ScanoutPush {
#endif
    uvec2 output_size;      // Exact window swapchain size OR 3840x2160 for 4K export
    uvec2 scan_size;        // x = 2560, y = active scanlines per field (e.g. 224/240 or 540)
    uvec2 raw_size;         // Source input pixel dimensions (e.g. 320x224 or 256x240)
    uint  frame_count;      // 60Hz/50Hz broadcast field counter (advances at native emulator FPS!)
    uint  scan_format;      // 0 = Progressive (240p/288p), 1 = Interlaced (480i/576i), 2 = 1080i DRC Hi-Scan
    uint  signal_standard;  // 0 = NTSC (SMPTE-C / Sony 9300K Red-Push, 59.94Hz), 1 = PAL (EBU P22, 50Hz)
    uint  input_mode;       // 0 = VIDEO 1 Composite (CVBS), 1 = VIDEO 2 S-Video (Y/C), 2 = VIDEO 4 Component/RGB
    uint  osd_mode;         // 0 = Off, 1 = Top-Right Input Banner Only, 2 = Full Interactive WEGA OSD Menu
    uint  osd_selected_row; // 0..9 selected parameter row in OSD menu
    uint  perf_overlay_on;  // 1 = Show compact bottom-right performance telemetry HUD (F key)
    uint  mask_layout;      // 0 = Sony SFP (0.45mm), 1 = Consumer WEGA (0.75mm), 2 = BVM-D24 (0.25mm), 3 = Slot Mask, 4 = Dot-Trio Shadow Mask
    uint  aspect_mode;      // 0 = 4:3 CRT Pillarbox (3:4 in TATE), 1 = 16:9 Wide Tube, 2 = Full Window Stretch
    float sfp_pitch_mm;     // Aperture grille pitch control (0.45 default)
    float hv_breathing;     // 0.005 DA-4 HV regulation sag
    float damper_str;       // 0.14 dual tungsten damper wires
    float brightness_gain;  // HDR Peak Phosphor Luminance Headroom (H key toggles)
    float split_wipe;       // >0: Left=Raw Nearest, Right=CRT; <0: Left=CRT, Right=Raw; 0.0: Full CRT
    float beam_sigma_scale; // User-tunable vertical electron beam spot scale (1.00 default, - / = keys)
    float vm_strength;      // ClearEdge VM strength (displayed in OSD)
    float horiz_smear;      // Horizontal spot bloom / smear (displayed in OSD)
    float comb_strength;    // Space-charge bloom / composite crosstalk (displayed in OSD)
    float perf_fps;         // Smoothed real-time display/emulator FPS
    float perf_frame_ms;    // Smoothed frame time in ms
    float perf_gpu_ms;      // Smoothed Vulkan compute dispatch time in ms
    float zoom_factor;      // Interactive macro loupe magnification (e.g. 8.0x when Z is active, 0.0 when off)
    float zoom_center_x;    // Normalized mouse cursor X for 8x macro phosphor loupe
    float zoom_center_y;    // Normalized mouse cursor Y for 8x macro phosphor loupe
    float field_ms;         // emulated field period
    float window_ms;        // display refresh interval being represented (0 = time-averaged)
    float cur_start_ms;     // start of the latest field's scan, relative to the window start
    float output_mode;      // 0 = sRGB SDR, 1 = extended linear (1.0 = sdr_ref_nits), 2 = HDR10 PQ (BT.2020, absolute)
    float crt_white_nits;   // luminance of a flat full-drive field on the simulated tube
    float display_peak_nits;
    float sdr_ref_nits;     // what 1.0 means in extended-linear output
    float panel_tau_ms;     // host panel pixel response (first-order); 0 = ideal
    float subpixel_layout;  // host panel subpixels: 0 = treat pixels as points, 1 = RGB stripe, 2 = BGR stripe
    float mask_strength;    // aperture grille contrast at 1x; 0 = per-layout default
} pc;

uvec2 pack8x8(uint r0, uint r1, uint r2, uint r3, uint r4, uint r5, uint r6, uint r7) {
    return uvec2((r0 << 24u) | (r1 << 16u) | (r2 << 8u) | r3,
                 (r4 << 24u) | (r5 << 16u) | (r6 << 8u) | r7);
}

uvec2 get_glyph_8x8(int ch) {
    switch (ch) {
        case 32: return uvec2(0u, 0u);
        case 37: return pack8x8(0x62,0x64,0x08,0x10,0x26,0x46,0x00,0x00); // '%'
        case 40: return pack8x8(0x0C,0x18,0x30,0x30,0x30,0x18,0x0C,0x00); // '('
        case 41: return pack8x8(0x30,0x18,0x0C,0x0C,0x0C,0x18,0x30,0x00); // ')'
        case 45: return pack8x8(0x00,0x00,0x00,0x7E,0x7E,0x00,0x00,0x00); // '-'
        case 46: return pack8x8(0x00,0x00,0x00,0x00,0x00,0x18,0x18,0x00); // '.'
